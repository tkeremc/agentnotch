{
  "sourceLanguage": "en",
  "strings": {
    "clock.dateAccessibility": {
      "comment": "Accessibility label for the clock date. First argument is the formatted date; second is the weekday. Arguments may be reordered.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, %2$@"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, %2$@"
          }
        }
      }
    },
    "clock.timeAccessibility": {
      "comment": "Accessibility label for the clock time. %@ is the formatted local time.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Time %@"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saat %@"
          }
        }
      }
    },
    "fileShelf.cannotAccess": {
      "comment": "File access error. %@ is the original file name.",
      "extractionState": "manual",
      "localizations": {
