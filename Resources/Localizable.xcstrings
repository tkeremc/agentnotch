    "settings.motionDescription": {
      "comment": "Footer explaining motion settings. Reduce Motion is the macOS accessibility setting.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Higher speeds make transitions shorter. With animations disabled, the island opens and closes instantly. The system’s Reduce Motion setting is always respected."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hız arttıkça geçişler kısalır. Animasyonları kapattığında ada anında açılıp kapanır. Sistemin Hareketi Azalt seçeneğine her zaman uyulur."
          }
        }
