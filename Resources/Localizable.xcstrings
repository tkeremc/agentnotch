    "claude.connectPermission" : {
      "comment" : "Claude Code integration: connectPermission. Keep product and API names unchanged.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adds local activity hooks and a usage status line to Claude Code settings. Your existing status line is preserved. No login, API key or network access is needed. Start a new Claude Code session after connecting."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Claude Code ayarlarına yerel etkinlik hook’ları ve kota durum çubuğu ekler. Mevcut durum çubuğunuz korunur. Giriş, API anahtarı veya ağ erişimi gerekmez. Bağlandıktan sonra yeni bir Claude Code oturumu başlatın."
          }
        }
      }
    },
    "claude.connectQuestion" : {
