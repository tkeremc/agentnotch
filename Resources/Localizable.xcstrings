    "fileShelf.description": {
      "comment": "Empty shelf explanation. Files are references and are not moved or copied.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your files stay where they are, kept close at hand here."
