    "codex.connectPermission" : {
      "comment" : "Codex connection confirmation or automatic discovery status. Codex was found automatically. AgentNotch will add its activity connection to show agents and permission requests. Existing hooks are preserved. No sign-in is needed. You will also need to review and trust the new hooks in Codex.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Codex was found automatically. AgentNotch will add its activity connection to show agents and permission requests. Existing hooks are preserved. No sign-in is needed. You will also need to review and trust the new hooks in Codex."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Codex otomatik bulundu. AgentNotch, ajanları ve izin isteklerini göstermek için etkinlik bağlantısını ekleyecek. Mevcut hook’ların korunur. Yeniden giriş gerekmez. Yeni hook’ları ayrıca Codex içinde inceleyip onaylaman gerekir."
          }
        }
      }
    },
